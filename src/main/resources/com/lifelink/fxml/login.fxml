<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.effect.DropShadow?>

<StackPane styleClass="login-root" xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml" fx:controller="com.lifelink.controller.LoginController">

    <HBox styleClass="login-shell" maxWidth="920" maxHeight="560" alignment="CENTER">

        <!-- Left brand panel -->
        <VBox styleClass="login-brand-pane" prefWidth="380" minWidth="380" alignment="TOP_LEFT" spacing="0">
            <VBox alignment="TOP_LEFT">
                <padding><Insets top="44" left="40" right="36" /></padding>
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Life" styleClass="login-brand-logo" />
                    <Label text="Link" styleClass="login-brand-logo-accent" />
                </HBox>
                <Label text="Blood Bank &amp; Emergency Donor Network" styleClass="login-brand-tagline" wrapText="true">
                    <VBox.margin><Insets top="10" /></VBox.margin>
                </Label>
            </VBox>

            <VBox spacing="18" VBox.vgrow="ALWAYS" alignment="CENTER_LEFT">
                <padding><Insets left="40" right="32" /></padding>
                <VBox styleClass="login-feature-row" spacing="2">
                    <Label text="24 / 7 EMERGENCY MATCHING" styleClass="login-feature-title" />
                    <Label text="Compatible donors notified in seconds" styleClass="login-feature-sub" wrapText="true" />
                </VBox>
                <VBox styleClass="login-feature-row" spacing="2">
                    <Label text="LIVE INVENTORY" styleClass="login-feature-title" />
                    <Label text="Track units by type, expiry, and status" styleClass="login-feature-sub" wrapText="true" />
                </VBox>
                <VBox styleClass="login-feature-row" spacing="2">
                    <Label text="NEARBY NETWORK" styleClass="login-feature-title" />
                    <Label text="Find donors and blood banks near you" styleClass="login-feature-sub" wrapText="true" />
                </VBox>
            </VBox>

            <VBox alignment="BOTTOM_LEFT">
                <padding><Insets left="40" bottom="30" right="32" /></padding>
                <Label text="&quot;Every donor. Every request. One network.&quot;" styleClass="login-brand-quote" wrapText="true" />
            </VBox>
        </VBox>

        <!-- Right form panel -->
        <VBox styleClass="login-form-pane" prefWidth="420" minWidth="420" alignment="CENTER">
            <VBox maxWidth="300" spacing="0">
                <VBox spacing="4">
                    <Label text="Welcome back" styleClass="login-form-title" />
                    <Label text="Sign in to continue saving lives." styleClass="login-form-subtitle" wrapText="true" />
                </VBox>

                <VBox spacing="6">
                    <padding><Insets top="30" /></padding>
                    <Label text="EMAIL" styleClass="field-label-dark" />
                    <TextField fx:id="emailField" promptText="you@example.com" styleClass="login-input" />
                </VBox>

                <VBox spacing="6">
                    <padding><Insets top="16" /></padding>
                    <Label text="PASSWORD" styleClass="field-label-dark" />
                    <PasswordField fx:id="passwordField" promptText="••••••••" styleClass="login-input" />
                </VBox>

                <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" managed="false" visible="false" maxWidth="300">
                    <VBox.margin><Insets top="12" /></VBox.margin>
                </Label>

                <Button text="Log In" styleClass="btn-primary" maxWidth="Infinity" onAction="#handleLogin">
                    <VBox.margin><Insets top="26" /></VBox.margin>
                </Button>

                <HBox alignment="CENTER" spacing="4">
                    <VBox.margin><Insets top="20" /></VBox.margin>
                    <Label text="Don't have an account?" styleClass="login-form-subtitle" />
                    <Button text="Sign Up" styleClass="link-button" onAction="#goToSignup" />
                </HBox>
            </VBox>
        </VBox>
    </HBox>
</StackPane>
