<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane styleClass="app-background" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml" fx:controller="com.lifelink.controller.MapController">
    <top>
        <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="14">
            <Button text="Back" styleClass="btn-secondary" onAction="#goBack" />
            <VBox>
                <Label text="Blood network" styleClass="topbar-title" />
                <Label text="Find people and services connected to LifeLink" styleClass="auth-subtitle" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Notifications" styleClass="btn-secondary" onAction="#openNotifications" />
            <Button text="Statistics" styleClass="btn-secondary" onAction="#openStatistics" />
            <Button text="Refresh" styleClass="btn-primary" onAction="#refreshDirectory" />
        </HBox>
    </top>
    <center>
        <VBox styleClass="content-area" spacing="18">
            <VBox styleClass="page-heading" spacing="4">
                <Label text="Blood network directory" styleClass="section-heading" />
                <Label text="Search available donors, recipients, blood banks, and active blood requests from the live database." styleClass="muted-text" wrapText="true" />
            </VBox>
            <HBox spacing="12" alignment="CENTER_LEFT" styleClass="directory-toolbar">
                <TextField fx:id="searchField" promptText="Search name, blood type, location, phone, or status" HBox.hgrow="ALWAYS" />
                <ComboBox fx:id="categoryFilter" prefWidth="150" />
            </HBox>
            <SplitPane VBox.vgrow="ALWAYS" dividerPositions="0.72">
                <ScrollPane fitToWidth="true" styleClass="directory-scroll">
                    <content>
                        <VBox fx:id="markerList" spacing="10" styleClass="directory-list" />
                    </content>
                </ScrollPane>
                <VBox prefWidth="270" spacing="14" styleClass="directory-sidebar">
                    <VBox styleClass="card" spacing="8">
                        <Label text="NETWORK STATUS" styleClass="card-title" />
                        <Label fx:id="networkSummary" text="Loading records..." styleClass="card-metric-sub" wrapText="true" />
                    </VBox>
                    <VBox styleClass="card" spacing="8" VBox.vgrow="ALWAYS">
                        <Label text="SELECTED RECORD" styleClass="card-title" />
                        <Label fx:id="selectedMarkerLabel" text="Select a record for contact and location details." styleClass="muted-text" wrapText="true" />
                    </VBox>
                </VBox>
            </SplitPane>
        </VBox>
    </center>
</BorderPane>
