<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.text.*?>

<StackPane fx:id="root" styleClass="splash-root" xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml" fx:controller="com.lifelink.controller.SplashController">
    <VBox alignment="CENTER" spacing="18">
        <StackPane fx:id="dropContainer" alignment="CENTER">
            <ImageView fitHeight="128" fitWidth="128" preserveRatio="true"
                       smooth="true">
                <image>
                    <Image url="@/com/lifelink/assets/lifelink-icon.png" />
                </image>
            </ImageView>
        </StackPane>

        <Label fx:id="titleLabel" text="LIFELINK" styleClass="splash-title" opacity="0" />
        <Label fx:id="taglineLabel" text="Connecting People. Saving Lives." styleClass="splash-tagline" opacity="0" />
        <Label fx:id="hintLabel" text="Press Any Key to Continue" styleClass="splash-hint" opacity="0" />
    </VBox>
</StackPane>
